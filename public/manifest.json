{
  "manifest_version": 3,
  "name": "YouTube Language Lab",
  "description": "双语字幕、混合练习、AI 跟读评分和本地词句库，账号与 Pro 权限体系已预留。",
  "version": "0.1.22",
  "action": {
    "default_title": "YouTube Language Lab",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [],
  "optional_host_permissions": [],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
